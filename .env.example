# Copy to .env for local development. .env is gitignored; never commit real values.
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-attachments-bucket
# Local: the organizer Docker server. Deployed: gs://<bucket>/dataset (set by deploy.sh).
INBOX_SOURCE=http://localhost:8080
# GEMINI_API_KEY comes from Secret Manager on Cloud Run; set it here only for local dev.
GEMINI_API_KEY=your-gemini-api-key
