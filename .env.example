# Copy to .env for local development. .env is gitignored and .dockerignored;
# never commit real values. On Cloud Run these come from scripts/deploy.sh.

# --- required ---------------------------------------------------------------
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-attachments-bucket
# Where emails come from: gs://<bucket>/dataset (the uploaded bundle, what the
# deployed service uses), http://localhost:8080 (the organizer Docker server),
# or a local folder containing inbox/ and attachments/.
INBOX_SOURCE=gs://your-attachments-bucket/dataset

# --- LLM ----------------------------------------------------------------------
# Leave GEMINI_API_KEY empty (or delete the line) to use Vertex AI on GCP_PROJECT
# via Application Default Credentials — the default and what Cloud Run uses.
# Set it only as a fallback to the Gemini Developer API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=global
# Optional tuning (defaults shown): thinking budget for gemini-2.5, and the
# minimum seconds between calls when a thread pool is running.
#GEMINI_THINKING_BUDGET=0
#GEMINI_MIN_INTERVAL_S=0.15

# --- optional -------------------------------------------------------------------
# Firestore collection holding the cases (default "cases"). Point at another
# collection to test a run without touching the shared data.
#FIRESTORE_COLLECTION=cases
# Organizer scoring server (POST /submit). Only used by scripts/score.py.
SCORER_URL=http://localhost:8080
# Set to 1 only on your own machine to enable GET /debug/store. Never on Cloud Run.
DEBUG_ROUTES=0
