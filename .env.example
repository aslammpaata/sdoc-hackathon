# Copy to .env for local development. .env is gitignored; never commit real values.
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-attachments-bucket
# Local: the organizer Docker server. Deployed: gs://<bucket>/dataset (set by deploy.sh).
INBOX_SOURCE=http://localhost:8080
# GEMINI_API_KEY comes from Secret Manager on Cloud Run; set it here only for local dev.
GEMINI_API_KEY=your-gemini-api-key
# Set to 1 only on your own machine to enable GET /debug/store. Never on Cloud Run.
DEBUG_ROUTES=0
# LLM: leave GEMINI_API_KEY empty to use Vertex AI on GCP_PROJECT via ADC (default).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=global
# Organizer scoring server (POST /submit). Only needed for scripts/score.py.
SCORER_URL=http://localhost:8080
